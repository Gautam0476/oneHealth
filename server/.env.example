# Replace with your local MongoDB URI or MongoDB Atlas connection string.
# If your password has special characters like @ # / : %, URL-encode it first.
MONGO_URI=mongodb://127.0.0.1:27017/onehealth
# MONGODB_URI is also accepted as an alias, but MONGO_URI is recommended.
MONGO_SERVER_SELECTION_TIMEOUT_MS=10000
PORT=5000
CORS_ORIGIN=http://localhost:5173,http://localhost:5000
RATE_LIMIT_MAX=300

# Required before public deployment. Used to sign role login tokens.
AUTH_SECRET=change-this-long-random-secret

# Optional role passwords. Defaults exist for demo only.
ADMIN_PASSWORD=admin123
ANALYST_PASSWORD=analyst123
VIEWER_PASSWORD=viewer123

# Optional legacy admin token. Still accepted as x-admin-token for admin access.
ADMIN_TOKEN=

# Set false if you do not want configured role users upserted into MongoDB on server start.
BOOTSTRAP_AUTH_USERS=true
